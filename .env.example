# Neon PostgreSQL
# Runtime (Next.js/Vercel): use the Neon pooled connection string (hostname includes -pooler).
DATABASE_URL=

# Direct/unpooled connection: use only for schema migrations and maintenance commands.
DATABASE_URL_UNPOOLED=

# Paystack (server-only)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Application
# Production: https://samary.catpad.shop
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=

# Initial seller contact; may later be managed in site settings
SELLER_WHATSAPP_NUMBER=233559448932

# Keep customer order requests disabled until pricing and regulatory checks are complete
ORDERS_ENABLED=false
